APP_NAME=KasirAI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Database (isi dari Railway MySQL plugin) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=your-mysql-host.railway.internal
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=your-password

# ─── Session & Cache ───────────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# ─── Redis (opsional — untuk skala lebih besar) ─────────────────────────────
# Isi REDIS_URL (Railway plugin Redis) supaya cache/queue/session pindah ke Redis.
# Klien predis (pure-PHP, tanpa ekstensi redis). Kalau REDIS_URL kosong,
# aplikasi tetap jalan pakai database/file (fallback aman).
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=predis

# ─── Sanctum CORS — domain frontend yang diizinkan ────────────────────────
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app,localhost:3000
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Midtrans ──────────────────────────────────────────────────────────────
# Production keys diawali "Mid-", sandbox diawali "SB-Mid-"
MIDTRANS_SERVER_KEY=Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=true

# ─── Groq AI ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── AI Limits & Monitoring ────────────────────────────────────────────────
# Maksimal prompt AI per bulan untuk paket FREE (Pro/Enterprise unlimited)
AI_FREE_MONTHLY_LIMIT=5
AI_WARNING_THRESHOLD_PCT=30
AI_TOKEN_ALERT_THRESHOLD=50000

# ─── Mail — SMTP Gmail untuk kirim link reset password ────────────────────
# Cara bikin App Password Gmail (sebelum pakai):
#   1. Buka https://myaccount.google.com/apppasswords (wajib 2-Step Verification aktif)
#   2. "App name" bebas, mis. "KasirAI" → Generate → dapat 16 karakter
#   3. Masukkan ke MAIL_PASSWORD. Jangan pakai password Gmail biasa.
# Kalau belum mau kirim email beneran, biarkan MAIL_MAILER=log
# (email cuma ditulis ke file log, tidak benar-benar terkirim).
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply.kasirai@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS="noreply.kasirai@gmail.com"
MAIL_FROM_NAME="KasirAI"
