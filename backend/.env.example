APP_NAME=KasirAI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Database (isi dari TiDB Cloud / MySQL eksternal) ──────────────────────
DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=kasirai
DB_USERNAME=root
DB_PASSWORD=your-password

# ─── Session & Cache ───────────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# ─── Redis (opsional, untuk skala lebih besar) ─────────────────────────────
# Isi REDIS_URL (Render Redis / eksternal) supaya cache/queue/session pindah ke Redis.
# Klien predis (pure-PHP, tanpa ekstensi redis). Kalau REDIS_URL kosong,
# aplikasi tetap jalan pakai database/file (fallback aman).
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=predis

# ─── Sanctum CORS, domain frontend yang diizinkan ────────────────────────
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app,localhost:3000
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Midtrans ──────────────────────────────────────────────────────────────
# Production keys diawali "Mid-", sandbox diawali "SB-Mid-"
MIDTRANS_SERVER_KEY=Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=true

# ─── Groq AI ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── AI Limits & Monitoring ────────────────────────────────────────────────
# Maksimal prompt AI per bulan untuk paket FREE (Pro/Enterprise unlimited)
AI_FREE_MONTHLY_LIMIT=5
AI_WARNING_THRESHOLD_PCT=30
AI_TOKEN_ALERT_THRESHOLD=50000

# ─── Mail, kirim kode OTP reset password lewat Resend (HTTPS API) ─────────
# Render memblokir port SMTP keluar, jadi Gmail SMTP tidak bisa dipakai di production.
#   1. Daftar di https://resend.com → Domains → verifikasi domain (SPF/DKIM di DNS)
#   2. API Keys → Create → salin ke RESEND_API_KEY
#   3. MAIL_FROM_ADDRESS wajib memakai domain yang sudah terverifikasi.
# Lokal / belum mau kirim email beneran: MAIL_MAILER=log
# (email cuma ditulis ke storage/logs/laravel.log, OTP bisa dibaca dari sana).
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@sikasirai.com"
MAIL_FROM_NAME="KasirAI"
